# Local secrets only. Do not overwrite an existing .env or commit real values.
# Choose one provider supported by this MVP: openai, anthropic, google, deepseek.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides for strategy.yaml; use exact model IDs available to your account.
TRADINGAGENTS_LLM_PROVIDER=
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
# Optional HTTPS endpoint without credentials, query parameters or fragments.
# Precedence: TRADINGAGENTS_LLM_BACKEND_URL > OPENAI_BASE_URL (OpenAI only) > YAML backend_url.
# Leave both empty to use the provider's default endpoint.
TRADINGAGENTS_LLM_BACKEND_URL=
OPENAI_BASE_URL=

# Alpaca PAPER credentials only; LIVE endpoints are rejected in code.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
