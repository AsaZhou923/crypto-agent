[Unit]
Description=Send scheduled Crypto Agent Paper trade digest
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/optiplex/services/crypto-agent
ExecStart=/home/optiplex/services/crypto-agent/.venv/bin/python /home/optiplex/services/crypto-agent/scripts/paper_digest.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/optiplex/services/crypto-agent/runtime/local-scheduler/notification.env
UMask=0077
TimeoutStartSec=90
Restart=no
