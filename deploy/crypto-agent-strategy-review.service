[Unit]
Description=Codex read-only review of Crypto Agent Paper strategy and execution
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/optiplex/services/crypto-agent
ExecStart=/home/optiplex/services/crypto-agent/.venv/bin/python /home/optiplex/services/crypto-agent/scripts/strategy_review.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/optiplex/services/crypto-agent/runtime/local-scheduler/notification.env
UMask=0077
TimeoutStartSec=1800
KillMode=control-group
Restart=no
